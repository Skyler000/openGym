# WinterARC configuration — copy to .env and edit:  cp .env.example .env
#
# .env is gitignored and must STAY that way. Never commit a filled-in copy.
# Note: no secrets belong in here. The session-signing secret and the VAPID
# keypair are generated automatically into ./data on first boot and must never
# be committed either (that is what ./data/ is gitignored for).

# --- Passkey binding (WebAuthn) -------------------------------------------
# RP_ID is the exact hostname passkeys are bound to, and ORIGIN the exact URL
# the app is served from. If these do not match the address bar character for
# character, login fails with "verification failed".
# Changing RP_ID later invalidates every existing passkey.
RP_ID=localhost
ORIGIN=http://localhost:8080
RP_NAME=WinterARC

# --- Serving ---------------------------------------------------------------
# Host port for the web container. If 8080 is taken, change it here AND in ORIGIN.
WEB_PORT=8080

# --- Access control --------------------------------------------------------
# Comma-separated user ids that get the admin dashboard. Find yours in Settings
# after creating a profile. Leave empty for no admins (default: open instance).
ADMIN_UIDS=

# Require an invite code to create a new profile. 1/true/yes/on to enable.
# Strongly recommended for any instance reachable from the internet.
INVITE_ONLY=

# --- Sessions --------------------------------------------------------------
# Days a session cookie stays valid (default 90). Lower it for an instance on
# the open internet. Only affects cookies issued from that point onward.
SESSION_DAYS=90

# --- Push notifications ----------------------------------------------------
# VAPID contact, per the Web Push spec: a mailto: address or your site URL.
# Defaults to ORIGIN over HTTPS, mailto:admin@localhost otherwise.
VAPID_SUBJECT=
